node_modules/
# dist/ is committed on purpose: OpenCode v2 installs git plugins with
# ignoreScripts, so it cannot build on install. Rebuild + commit after changes.
*.log
.DS_Store
.env

# Yarn Berry ephemeral files (do NOT ignore .yarn/releases/, .yarn/patches/, .yarn/plugins/, .yarn/sdks/, .yarnrc.yml)
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
